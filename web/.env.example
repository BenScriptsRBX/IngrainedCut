# Copy to .env.local for local development; set the same names in Vercel → Project → Settings → Environment Variables.

# Public URL of the site (no trailing slash). Vercel production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google sign-in: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: <site url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres (Vercel → Storage → Neon). Leave empty locally to use an embedded dev database.
DATABASE_URL=

# Local testing only: shows "Sign in as test user". Ignored on Vercel production.
ICUT_DEV_LOGIN=1

# Ads in the website editor (lib/supporter.ts). The publisher ID is in lib/site.ts (adsenseClient); ADSENSE_CLIENT overrides it.
# ADSENSE_EDITOR_SLOT: AdSense → Ads → By ad unit → Display ads → a 728×90 fixed-size unit → its data-ad-slot number.
# Until the slot is set the editor shows no ads in production (and a placeholder box elsewhere).
ADSENSE_CLIENT=
ADSENSE_EDITOR_SLOT=

# Ko-fi supporters remove the ads. Ko-fi → Settings → More → API → Webhook URL: <site url>/api/kofi;
# copy the verification token shown there.
KOFI_VERIFICATION_TOKEN=
# Optional: KOFI_URL (default https://ko-fi.com/ingrainedcut) and AD_FREE_PRICE (default 2, in your Ko-fi currency)
